# Single env file for the whole stack (docker compose + local `make backend`).
# Keitaro Admin API
KEITARO_BASE_URL=https://your-tracker.example
KEITARO_API_KEY=change-me
# Defaults for new campaigns (ids from Keitaro)
KEITARO_DEFAULT_DOMAIN_ID=
KEITARO_DEFAULT_GROUP_ID=
KEITARO_DEFAULT_TRAFFIC_SOURCE_ID=
KEITARO_GEO_REDIRECT_URL=https://www.google.com

# Prepended to every created campaign name: campaign1 -> test_ponomaryov_campaign1
CAMPAIGN_NAME_PREFIX=test_lastname_

# PostgreSQL (container credentials; docker-compose overrides host to "db" for backend)
POSTGRES_USER=keitaro
POSTGRES_PASSWORD=keitaro
POSTGRES_DB=keitaro
DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5433/keitaro

CORS_ORIGINS=http://localhost:5173
