  "info": {
    "title": "Keitaro Campaign Tool",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/campaigns": {
      "get": {
        "operationId": "listCampaigns",
        "parameters": [
          {
            "description": "Substring of name, alias or id",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring of name, alias or id",
              "title": "Search"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CampaignOut"
                  },
                  "title": "Response Listcampaigns",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Campaigns",
        "tags": [
          "campaigns"
        ]
      },
      "post": {
        "operationId": "createCampaign",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CampaignCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Campaign",
        "tags": [
          "campaigns"
        ]
      }
    },
    "/api/campaigns/created": {
      "get": {
        "operationId": "listCreatedCampaigns",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CreatedCampaignOut"
                  },
                  "title": "Response Listcreatedcampaigns",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Created",
        "tags": [
          "campaigns"
        ]
      }
    },
    "/api/campaigns/{campaign_id}/changes": {
      "get": {
        "operationId": "listOfferChanges",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OfferChangeOut"
                  },
                  "title": "Response Listofferchanges",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Changes",
        "tags": [
          "editor"
        ]
      }
    },
    "/api/campaigns/{campaign_id}/editor": {
      "get": {
        "operationId": "getEditorView",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/StatsInterval",
              "default": "all_time"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditorView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Editor",
        "tags": [
          "editor"
        ]
      }
    },
    "/api/campaigns/{campaign_id}/streams/{stream_id}/offers": {
      "post": {
        "operationId": "addStreamOffer",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "stream_id",
            "required": true,
            "schema": {
              "title": "Stream Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddOfferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add Offer",
        "tags": [
          "editor"
        ]
      },
      "put": {
        "operationId": "setStreamOffers",
        "parameters": [
          {
            "in": "path",
            "name": "campaign_id",
            "required": true,
            "schema": {
              "title": "Campaign Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "stream_id",
            "required": true,
            "schema": {
              "title": "Stream Id",
              "type": "integer"
            }
          }
        ],
